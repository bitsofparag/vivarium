# Local Compose defaults. Copy to .env.local and edit.
# Rootful compatibility identity. Ignored by default rootless recipes.
VIVARIUM_ROOTFUL_UID=1000
VIVARIUM_ROOTFUL_GID=1000

# Optional build toggles.
VIVARIUM_INCLUDE_RUST=0
VIVARIUM_INCLUDE_ZIG=1
VIVARIUM_INCLUDE_DOCS=1
VIVARIUM_INCLUDE_SEMGREP=0
VIVARIUM_INCLUDE_AGENTS=1
VIVARIUM_INCLUDE_RTK=1
VIVARIUM_INCLUDE_CODEGRAPH=1
VIVARIUM_INCLUDE_CAVEMAN=1

# Optional upstream pins. Leave blank for latest where supported.
VIVARIUM_RTK_VERSION=
VIVARIUM_CODEGRAPH_VERSION=
VIVARIUM_CAVEMAN_REF=v1.9.1

# Optional runtime environment.
ANTHROPIC_API_KEY=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# VIVARIUM_PROMPT=%m:%~%#
