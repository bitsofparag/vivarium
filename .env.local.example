# Local Compose defaults. Copy to .env.local and edit.
VIVARIUM_WORKSPACE=./workspace
VIVARIUM_UID=1000
VIVARIUM_GID=1000

# Optional build toggles.
VIVARIUM_INCLUDE_RUST=0
VIVARIUM_INCLUDE_ZIG=1
VIVARIUM_INCLUDE_DOCS=1
VIVARIUM_INCLUDE_SEMGREP=0
VIVARIUM_INCLUDE_AGENTS=1

# Optional runtime environment.
ANTHROPIC_API_KEY=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# VIVARIUM_PROMPT=%m:%~%#

# Optional compose overlays.
# VIVARIUM_EXTRA_REPO=../other-repo
# VIVARIUM_READ_ONLY_DATA=../data
# VIVARIUM_DOCKER_SOCKET=/run/user/1000/docker.sock
